rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasRole(roles) {
      return hasProfile()
        && currentUser().data.status == "active"
        && currentUser().data.role in roles;
    }


    match /users/{uid} {
      allow create: if isOwner(uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == "member"
        && request.resource.data.status == "active";

      allow read: if isOwner(uid) || hasRole(["board", "admin"]);

      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["profile", "lastLoginAt", "updatedAt"])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status;

      allow update, delete: if hasRole(["board", "admin"]);
    }

    match /memberships/{membershipId} {
      allow read: if signedIn() &&
        (resource.data.userId == request.auth.uid || hasRole(["board", "admin"]));
      allow create, update, delete: if hasRole(["board", "admin"]);
    }

    match /memberDirectory/{memberId} {
      allow read, create, update, delete: if hasRole(["admin"]);
    }

    match /events/{eventId} {
      allow read: if signedIn();
      allow create, update, delete: if hasRole(["board", "admin"]);
    }

    function registrationDocId(activityId) {
      return activityId + "__" + request.auth.uid;
    }

    function registrationAfter(activityId) {
      return getAfter(
        /databases/$(database)/documents/registrations/$(registrationDocId(activityId))
      );
    }

    function registrationBefore(activityId) {
      return get(
        /databases/$(database)/documents/registrations/$(registrationDocId(activityId))
      );
    }

    function registrationExists(activityId) {
      return exists(
        /databases/$(database)/documents/registrations/$(registrationDocId(activityId))
      );
    }

    function activityCapacityAllows(activityId, count) {
      return get(/databases/$(database)/documents/activities/$(activityId)).data.capacity <= 0
        || count <= get(/databases/$(database)/documents/activities/$(activityId)).data.capacity;
    }

    function statsAfter(activityId) {
      return getAfter(
        /databases/$(database)/documents/activityStats/$(activityId)
      );
    }

    function statsBefore(activityId) {
      return get(
        /databases/$(database)/documents/activityStats/$(activityId)
      );
    }

    match /activities/{activityId} {
      allow read: if signedIn();
      allow create, update, delete: if hasRole(["admin"]);
    }

    match /activityStats/{activityId} {
      allow read: if signedIn();

      allow create: if hasRole(["admin"])
        || (
          signedIn()
          && request.resource.data.eventId == activityId
          && request.resource.data.registeredCount is int
          && request.resource.data.registeredCount >= 0
          && activityCapacityAllows(activityId, request.resource.data.registeredCount)
          && (
            (
              !registrationExists(activityId)
              && registrationAfter(activityId).data.status == "registered"
              && request.resource.data.registeredCount
                == get(/databases/$(database)/documents/activities/$(activityId)).data.registered + 1
            )
            || (
              registrationExists(activityId)
              && registrationBefore(activityId).data.status == "cancelled"
              && registrationAfter(activityId).data.status == "registered"
              && request.resource.data.registeredCount
                == get(/databases/$(database)/documents/activities/$(activityId)).data.registered + 1
            )
            || (
              registrationExists(activityId)
              && registrationBefore(activityId).data.status == "registered"
              && registrationAfter(activityId).data.status == "cancelled"
              && request.resource.data.registeredCount
                == get(/databases/$(database)/documents/activities/$(activityId)).data.registered - 1
              && request.resource.data.registeredCount >= 0
            )
          )
        );

      allow update: if hasRole(["admin"])
        || (
          signedIn()
          && request.resource.data.eventId == resource.data.eventId
          && request.resource.data.eventId == activityId
          && request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly(["registeredCount", "updatedAt"])
          && request.resource.data.registeredCount is int
          && request.resource.data.registeredCount >= 0
          && activityCapacityAllows(activityId, request.resource.data.registeredCount)
          && (
            (
              request.resource.data.registeredCount == resource.data.registeredCount + 1
              && (
                !registrationExists(activityId)
                || registrationBefore(activityId).data.status == "cancelled"
              )
              && registrationAfter(activityId).data.status == "registered"
            )
            || (
              request.resource.data.registeredCount == resource.data.registeredCount - 1
              && registrationExists(activityId)
              && registrationBefore(activityId).data.status == "registered"
              && registrationAfter(activityId).data.status == "cancelled"
            )
          )
        );

      allow delete: if hasRole(["admin"]);
    }

    match /registrations/{registrationId} {
      allow read: if signedIn() &&
        (resource.data.userId == request.auth.uid || hasRole(["board", "admin"]));
      allow create: if hasProfile()
        && currentUser().data.status == "active"
        && request.resource.data.userId == request.auth.uid
        && registrationId == request.resource.data.eventId + "__" + request.auth.uid
        && request.resource.data.membershipId is string
        && get(/databases/$(database)/documents/memberships/$(request.resource.data.membershipId)).data.userId == request.auth.uid
        && get(/databases/$(database)/documents/memberships/$(request.resource.data.membershipId)).data.status == "active"
        && request.resource.data.status == "registered"
        && statsAfter(request.resource.data.eventId).data.registeredCount >= 1
        && (
          (
            exists(/databases/$(database)/documents/activityStats/$(request.resource.data.eventId))
            && statsAfter(request.resource.data.eventId).data.registeredCount
              == statsBefore(request.resource.data.eventId).data.registeredCount + 1
          )
          || (
            !exists(/databases/$(database)/documents/activityStats/$(request.resource.data.eventId))
            && statsAfter(request.resource.data.eventId).data.registeredCount
              == get(/databases/$(database)/documents/activities/$(request.resource.data.eventId)).data.registered + 1
          )
        );
      allow update: if hasProfile()
        && currentUser().data.status == "active"
        && resource.data.userId == request.auth.uid
        && registrationId == resource.data.eventId + "__" + request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["membershipId", "status", "cancelledAt"])
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.eventId == resource.data.eventId
        && request.resource.data.payment == resource.data.payment
        && request.resource.data.registeredAt == resource.data.registeredAt
        && request.resource.data.status in ["registered", "cancelled"]
        && (
          (
            resource.data.status == "cancelled"
            && request.resource.data.status == "registered"
            && request.resource.data.membershipId is string
            && get(/databases/$(database)/documents/memberships/$(request.resource.data.membershipId)).data.userId == request.auth.uid
            && get(/databases/$(database)/documents/memberships/$(request.resource.data.membershipId)).data.status == "active"
            && statsAfter(resource.data.eventId).data.registeredCount
              == statsBefore(resource.data.eventId).data.registeredCount + 1
          )
          || (
            resource.data.status == "registered"
            && request.resource.data.status == "cancelled"
            && request.resource.data.membershipId == resource.data.membershipId
            && statsAfter(resource.data.eventId).data.registeredCount
              == statsBefore(resource.data.eventId).data.registeredCount - 1
          )
        );
      allow delete: if hasRole(["board", "admin"]);
    }

    match /committees/{committeeId} {
      allow read: if signedIn();
      allow create, update, delete: if hasRole(["board", "admin"]);
    }

    match /announcements/{announcementId} {
      allow read: if signedIn();
      allow create, update, delete: if hasRole(["board", "admin"]);
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read", "readAt"])
        && request.resource.data.userId == resource.data.userId;
      allow create, delete: if hasRole(["board", "admin"]);
    }

    match /appConfig/{document=**} {
      allow read: if signedIn();
      allow write: if hasRole(["admin"]);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
